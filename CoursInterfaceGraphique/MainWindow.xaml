<Window x:Class="CoursInterfaceGraphique.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CoursInterfaceGraphique"
        mc:Ignorable="d"
        Title="Cours interface graphique" Height="450" Width="800">
    <Grid>
        <!-- Commentaire -->
        <Label Name="lblNom" Content="Nom" HorizontalAlignment="Left" Margin="100,100,0,0" VerticalAlignment="Top" RenderTransformOrigin="-1.17,0.656" />
        <TextBox Name="txtNom" HorizontalAlignment="Left" Margin="100,150,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <Button Name="btnSoumettre" Content="Soumettre" HorizontalAlignment="Left" Margin="100,200,0,0" VerticalAlignment="Top" Width="120" Click="btnSoumettre_Click"/>
        <Label Name="lblBonjour" Content="" HorizontalAlignment="Left" Margin="100,250,0,0" VerticalAlignment="Top" RenderTransformOrigin="-1.17,0.656" />
    </Grid>
</Window>
